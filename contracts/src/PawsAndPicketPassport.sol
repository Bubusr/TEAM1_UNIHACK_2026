pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol";
import "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
import "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

/**
 * @title PawsAndPicketPassport
 * @notice ERC-721 Pet Passport NFT for Paws & Picket, verified via EIP-712 signed claims.
 * @dev Deployed on Avalanche Fuji Testnet (Chain ID: 43113).
 */
contract PawsAndPicketPassport is ERC721URIStorage, EIP712, Ownable {
    using ECDSA for bytes32;

    struct PassportClaim {
        address recipient;
        uint256 petId;
        string petName;
        string species;
        uint256 score;
        string tokenURI;
        uint256 nonce;
        uint256 deadline;
    }

    bytes32 public constant CLAIM_TYPEHASH = keccak256(
        "PassportClaim(address recipient,uint256 petId,string petName,string species,uint256 score,string tokenURI,uint256 nonce,uint256 deadline)"
    );

    address public trustedSigner;
    uint256 private _nextTokenId = 1;

    // Protection mappings
    mapping(uint256 => bool) public usedNonces;
    mapping(uint256 => bool) public petMinted;
    mapping(uint256 => uint256) public petIdToTokenId;

    // Events
    event PetPassportMinted(
        uint256 indexed tokenId,
        uint256 indexed petId,
        address indexed recipient,
        string petName,
        string species,
        uint256 score,
        string tokenURI
    );

    event TrustedSignerUpdated(address indexed previousSigner, address indexed newSigner);

    error CallerNotRecipient();
    error ClaimExpired();
    error NonceAlreadyUsed();
    error PetAlreadyHasPassport();
    error InvalidSigner();
    error ZeroAddressSigner();

    constructor(
        address initialSigner,
        address initialOwner
    ) 
        ERC721("Paws and Picket Passport", "PASSPORT") 
        EIP712("PawsAndPicketPassport", "1") 
        Ownable(initialOwner) 
    {
        if (initialSigner == address(0)) revert ZeroAddressSigner();
        trustedSigner = initialSigner;
        emit TrustedSignerUpdated(address(0), initialSigner);
    }

    /**
     * @notice Allows owner to update trusted backend signer
     * @param newSigner New signer address
     */
    function setTrustedSigner(address newSigner) external onlyOwner {
        if (newSigner == address(0)) revert ZeroAddressSigner();
        address oldSigner = trustedSigner;
        trustedSigner = newSigner;
        emit TrustedSignerUpdated(oldSigner, newSigner);
    }

    /**
     * @notice Computes hash for an EIP-712 PassportClaim
     * @param claim Struct containing claim parameters
     */
    function hashClaim(PassportClaim calldata claim) public view returns (bytes32) {
        return _hashTypedDataV4(
            keccak256(
                abi.encode(
                    CLAIM_TYPEHASH,
                    claim.recipient,
                    claim.petId,
                    keccak256(bytes(claim.petName)),
                    keccak256(bytes(claim.species)),
                    claim.score,
                    keccak256(bytes(claim.tokenURI)),
                    claim.nonce,
                    claim.deadline
                )
            )
        );
    }

    /**
     * @notice Mint Pet Passport with a valid EIP-712 signature from trustedSigner
     * @param claim The claim details
     * @param signature The EIP-712 signature generated by trustedSigner
     */
    function mintWithClaim(
        PassportClaim calldata claim,
        bytes calldata signature
    ) external returns (uint256) {
        if (msg.sender != claim.recipient) revert CallerNotRecipient();
        if (block.timestamp > claim.deadline) revert ClaimExpired();
        if (usedNonces[claim.nonce]) revert NonceAlreadyUsed();
        if (petMinted[claim.petId]) revert PetAlreadyHasPassport();

        bytes32 digest = hashClaim(claim);
        address recoveredSigner = ECDSA.recover(digest, signature);
        if (recoveredSigner != trustedSigner || recoveredSigner == address(0)) {
            revert InvalidSigner();
        }

        usedNonces[claim.nonce] = true;
        petMinted[claim.petId] = true;

        uint256 tokenId = _nextTokenId++;
        petIdToTokenId[claim.petId] = tokenId;

        _safeMint(claim.recipient, tokenId);
        _setTokenURI(tokenId, claim.tokenURI);

        emit PetPassportMinted(
            tokenId,
            claim.petId,
            claim.recipient,
            claim.petName,
            claim.species,
            claim.score,
            claim.tokenURI
        );

        return tokenId;
    }

    /**
     * @notice Returns total minted passports count
     */
    function totalMinted() external view returns (uint256) {
        return _nextTokenId - 1;
    }
}
