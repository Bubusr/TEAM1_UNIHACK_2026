# BusQuest — Bản demo trên testnet (Avalanche Fuji C-Chain)
# Sao chép file này thành .env và điền giá trị thật

DATABASE_URL="file:./dev.db"

# Avalanche Fuji Testnet
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Contract addresses (cập nhật sau khi deploy)
NEXT_PUBLIC_CHECK_IN_MANAGER=
NEXT_PUBLIC_BADGE_NFT=
NEXT_PUBLIC_VOUCHER_MANAGER=

# Privy embedded wallet
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server-side verifier key (KHÔNG được commit giá trị thật)
VERIFIER_PRIVATE_KEY=
VERIFIER_ADDRESS=

# Demo mode — bật để bỏ qua kiểm tra khoảng cách GPS
NEXT_PUBLIC_DEMO_MODE=false
