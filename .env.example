# ==============================================================================
# Paws & Picket: Phase 1 Environment Configuration (Placeholders Only)
# ==============================================================================
# Never prefix server secrets with VITE_ or commit real keys.

# ------------------------------------------------------------------------------
# 1. Core Phase 1 Runtime Secrets
# ------------------------------------------------------------------------------
# Optional client SDK key for Firebase Web App (read by Vite frontend)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# Required in production (minimum 32 random chars, e.g. `openssl rand -hex 32`).
# Signs guest session HMAC cookies/tokens stably across restarts and instances.
GUEST_SESSION_SECRET="MY_GUEST_SESSION_SECRET"

# Required only for live Gemini AI Photo Judging (/api/judge).
# Sanctuary, Farm, Care, Neighbors, and First Bond Quest run cleanly without it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. PostgreSQL Persistence (Managed Automatically by Cloud SQL)
# ------------------------------------------------------------------------------
# Cloud SQL runtime variables (SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME) are
# automatically injected by AI Studio and retained as a valid fallback.
# Standalone deployments may optionally provide a PostgreSQL connection string via
# DATABASE_URL.

# ------------------------------------------------------------------------------
# 3. Optional / Post-Deployment Avalanche Fuji Web3 Configuration
# ------------------------------------------------------------------------------
# Safe Fuji defaults are built into the server:
#   AVALANCHE_FUJI_RPC_URL defaults to https://api.avax-test.network/ext/bc/C/rpc
#   AVALANCHE_CHAIN_ID defaults to 43113
#   METADATA_STORAGE_PROVIDER defaults to "server" (/api/metadata/:petUid)
#
# Set only when enabling live on-chain Fuji Pet Passport minting:
#   - TRUSTED_SIGNER_PRIVATE_KEY: backend EIP-712 mint claim signing key
#   - PET_PASSPORT_CONTRACT_ADDRESS: set AFTER deploying PawsAndPicketPassport.sol
#   - METADATA_STORAGE_API_KEY: required ONLY when METADATA_STORAGE_PROVIDER is "pinata"
#   - APP_URL: optional public origin override (auto-detected from request host if omitted)
#
# CLI deployment only (never required by the runtime app server):
#   - DEPLOYER_PRIVATE_KEY: used only when running `npx hardhat run scripts/deploy-fuji.ts --network fuji`
#
# Phase 2 deferred (NOT used or required in Phase 1):
#   - PawBadges contract address is deferred to Phase 2.
